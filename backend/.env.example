# eDNA Evidence Investigator Backend - Development Configuration

# Database connection. URL-encode reserved password characters (for example,
# use %40 for @) before placing the value in DATABASE_URL.
DATABASE_URL=postgresql://edna_user:replace_with_url_encoded_password@localhost:5432/eDna

# Preflight data directory (relative to project root)
PREFLIGHT_DATA_DIR=data_preflight/outputs

# Server configuration
HOST=0.0.0.0
PORT=8000

# Environment settings
ENVIRONMENT=development
DEBUG=true

# Optional AI narrative generation (never expose these via VITE_ variables).
AI_REPORTS_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
